    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "emailSuperAdmin", "value": "20261019m@sis.hust.edu.vn" },
    { "key": "passwordSuperAdmin", "value": "Admin@2026" },
    { "key": "emailUserManager", "value": "thanhvien1@sis.hust.edu.vn" },
    { "key": "passwordUserManager", "value": "Member@2026" },
    { "key": "emailAuditor", "value": "thanhvien2@sis.hust.edu.vn" },
    { "key": "passwordAuditor", "value": "Member@2026" },
    { "key": "emailMember", "value": "banxungquanh1@sis.hust.edu.vn" },
    { "key": "passwordMember", "value": "Member@2026" },
    { "key": "tokenSuperAdmin", "value": "" },
    { "key": "tokenUserManager", "value": "" },
    { "key": "tokenAuditor", "value": "" },
    { "key": "tokenMember", "value": "" },
    { "key": "roleIdSuperAdmin", "value": "" },
    { "key": "roleIdUserManager", "value": "" },
    { "key": "roleIdAuditor", "value": "" },
