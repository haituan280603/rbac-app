              "raw": "{\n  \"code\": \"demo-in-use\",\n  \"name\": \"Demo In Use\",\n  \"permissions\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('demoRoleId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "T21b Gan role tam cho 1 user (de role dang duoc dung)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSuperAdmin}}" }
            ],
            "url": "{{baseUrl}}/users/{{selfId}}/roles/{{demoRoleId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "T21c DELETE role dang dung -> 409 ROLE_IN_USE",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSuperAdmin}}" }
            ],
            "url": "{{baseUrl}}/roles/{{demoRoleId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('ROLE_IN_USE', () => pm.expect(pm.response.json().error.code).to.eql('ROLE_IN_USE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "T22 PUT /roles/:id/permissions co ma sai -> 400 PERMISSION_NOT_FOUND",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSuperAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/roles/{{demoRoleId}}/permissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\"users:fly\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('PERMISSION_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('PERMISSION_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "T23 Header X-User-Role gia (member) -> van 403 (BR-09)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenMember}}" },
              { "key": "X-User-Role", "value": "admin" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hack@sis.hust.edu.vn\",\n  \"fullName\": \"Hack\",\n  \"password\": \"Hack@2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 du co header gia', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "T24 POST /users body JSON hong -> 400 MALFORMED_JSON",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSuperAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users",
            "body": { "mode": "raw", "raw": "{not valid json" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('MALFORMED_JSON', () => pm.expect(pm.response.json().error.code).to.eql('MALFORMED_JSON'));"
                ]
              }
            }
          ]
        }
      ]
    }
