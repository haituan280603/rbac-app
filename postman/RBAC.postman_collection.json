  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Login super-admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{emailSuperAdmin}}\",\n  \"password\": \"{{passwordSuperAdmin}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 va co accessToken', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().accessToken).to.be.a('string'); });",
                  "pm.collectionVariables.set('tokenSuperAdmin', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user-manager",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{emailUserManager}}\",\n  \"password\": \"{{passwordUserManager}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 va co accessToken', () => { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('tokenUserManager', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login auditor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{emailAuditor}}\",\n  \"password\": \"{{passwordAuditor}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 va co accessToken', () => { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('tokenAuditor', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{emailMember}}\",\n  \"password\": \"{{passwordMember}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 va co accessToken', () => { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('tokenMember', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lay role id (GET /roles)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSuperAdmin}}" }
            ],
            "url": "{{baseUrl}}/roles?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json().data;",
                  "const find = (code) => (data.find(r => r.code === code) || {}).id || '';",
                  "pm.collectionVariables.set('roleIdSuperAdmin', find('super-admin'));",
                  "pm.collectionVariables.set('roleIdUserManager', find('user-manager'));",
                  "pm.collectionVariables.set('roleIdAuditor', find('auditor'));",
                  "pm.collectionVariables.set('roleIdMember', find('member'));",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
